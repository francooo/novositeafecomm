---
import Brand from './Brand.astro';
import { services } from '../data/services';
import { SITE, WA_URL, TEL_URL, MAIL_URL } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <Brand label="AF Negócios Digitais — início" />
      <p>Construindo seu negócio com tecnologia, estratégia e parceria para e-commerce.</p>
      <div class="footer-social">
        <a class="text-link" href={WA_URL} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a class="text-link" href={MAIL_URL}>E-mail</a>
      </div>
    </div>
    <nav class="footer-column" aria-label="Soluções">
      <h2 class="footer-heading">Soluções</h2>
      {services.slice(0, 5).map((s) => <a class="footer-link" href={s.path}>{s.title}</a>)}
    </nav>
    <nav class="footer-column" aria-label="Empresa">
      <h2 class="footer-heading">Empresa</h2>
      <a class="footer-link" href="/sobre">Sobre nós</a>
      <a class="footer-link" href="/processo">Como trabalhamos</a>
      <a class="footer-link" href="/cases">Histórias de clientes</a>
      <a class="footer-link" href="/faq">Perguntas frequentes</a>
      <a class="footer-link" href="/contato">Contato</a>
    </nav>
    <div class="footer-column">
      <h2 class="footer-heading">Vamos conversar?</h2>
      <a class="footer-link" href={TEL_URL}>{SITE.phoneDisplay}</a>
      <a class="footer-link" href={MAIL_URL}>{SITE.email}</a>
      <a class="footer-link footer-cta" href="/contato">Fale com a equipe</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {year} AF Negócios Digitais</span>
    <span class="legal-links">
      <a class="footer-link" href="/privacidade">Privacidade</a>
      <a class="footer-link" href="/termos">Termos</a>
      <a class="footer-link" href="/lgpd">LGPD</a>
    </span>
  </div>
</footer>
