---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, TEL_URL, MAIL_URL, WA_URL } from '../data/site';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contato — AF Negócios Digitais',
    url: new URL('/contato', Astro.site).href,
    about: { '@id': new URL('/#organization', Astro.site).href },
  },
];
---
<BaseLayout
  title="Contato | AF Negócios Digitais — Fale com a equipe"
  description={`Fale com a AF Negócios Digitais pelo WhatsApp ${SITE.phoneDisplay} ou e-mail ${SITE.email} e conte sobre o seu projeto de e-commerce.`}
  breadcrumbs={[{ name: 'Contato', href: '/contato' }]}
  schema={schema}
>
  <section class="contact-hero section-wrap">
    <div class="contact-copy">
      <span class="eyebrow eyebrow-pill"><span class="status-dot"></span> Fale com a gente</span>
      <h1>Vamos conversar sobre <em>seu próximo passo.</em></h1>
      <p class="hero-lead">Conte um pouco sobre o que você está construindo. A equipe pode ajudar a organizar a conversa e entender suas prioridades.</p>
      <div class="contact-options">
        <a href={WA_URL} class="contact-option" target="_blank" rel="noopener noreferrer"><Icon name="message" /><span><small>WhatsApp</small><b>{SITE.phoneDisplay}</b></span><Icon name="arrow" /></a>
        <a href={TEL_URL} class="contact-option"><Icon name="hand" /><span><small>Telefone</small><b>{SITE.phoneDisplay}</b></span><Icon name="arrow" /></a>
        <a href={MAIL_URL} class="contact-option"><Icon name="window" /><span><small>E-mail</small><b>{SITE.email}</b></span><Icon name="arrow" /></a>
      </div>
    </div>
    <div class="contact-form-card">
      <span class="eyebrow">Um primeiro contato</span>
      <h2>Conte sobre seu projeto</h2>
      <p>Preencha os campos e seu aplicativo de e-mail abrirá uma mensagem pronta para enviar.</p>
      <form id="contact-form" data-email={SITE.email} action={MAIL_URL} method="post" enctype="text/plain">
        <label for="contact-name">Seu nome</label>
        <input id="contact-name" name="name" autocomplete="name" required placeholder="Como podemos chamar você?" />
        <label for="contact-email">Seu e-mail</label>
        <input id="contact-email" type="email" name="email" autocomplete="email" required placeholder="voce@empresa.com" />
        <label for="contact-message">O que você precisa?</label>
        <textarea id="contact-message" name="message" rows="4" required placeholder="Conte brevemente sobre sua operação ou desafio"></textarea>
        <button class="button button-primary" type="submit">Preparar mensagem <Icon name="arrow" /></button>
        <small class="form-note">Nenhum dado é armazenado pelo site. A mensagem será preparada no seu aplicativo de e-mail.</small>
      </form>
    </div>
  </section>

  <section class="contact-bottom-band">
    <div class="section-wrap contact-bottom-inner">
      <span class="eyebrow">Prefere falar agora?</span>
      <h2>Estamos a uma mensagem de distância.</h2>
      <a href={WA_URL} class="button button-light" target="_blank" rel="noopener noreferrer">Abrir WhatsApp <Icon name="arrow" /></a>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const email = form.dataset.email ?? '';
    const subject = encodeURIComponent(`Contato pelo site — ${data.get('name')}`);
    const body = encodeURIComponent(`Nome: ${data.get('name')}\nE-mail: ${data.get('email')}\n\n${data.get('message')}`);
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>
